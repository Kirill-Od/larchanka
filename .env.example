# Скопируй в .env и заполни:  cp .env.example .env
# Файл .env в .gitignore и НЕ должен попадать в репозиторий.

# --- Telegram ---
# Токен от @BotFather. Обязательная переменная.
TELEGRAM_BOT_TOKEN=

# Транспорт апдейтов: polling (по умолчанию) | webhook
# polling  — не нужен домен и TLS, работает за NAT. Подходит локально и на VPS.
# webhook  — Telegram сам шлёт апдейты на публичный HTTPS-адрес.
TELEGRAM_TRANSPORT=polling

# --- Инференс (плагин) ---
# Доступны: ollama | openai_compat | echo
# Свой провайдер добавляется файлом в bot/providers/ — см. README.
LLM_PROVIDER=ollama

# Таймаут ожидания ответа модели, секунды. На слабом CPU лучше не меньше 120.
LLM_TIMEOUT=120

# Сколько процессов агента держать. Цикл агента всегда идёт вне процесса бота.
AGENT_WORKERS=1

# --- Агент: цикл, инструменты, скиллы ---
# Потолок шагов агентного цикла — защита от зацикливания. Разрешено 1..10.
AGENT_MAX_STEPS=8

# Бюджет времени на ОДИН запрос целиком, секунды. Шагов несколько, у каждого
# свой LLM_TIMEOUT, поэтому общий бюджет задаётся отдельно.
AGENT_TASK_TIMEOUT=300

# Показывать в чате «⚙️ exec: …» — какой инструмент агент вызывает прямо сейчас.
AGENT_SHOW_STEPS=true

# Каталог со скиллами (.md-инструкции). Пусто — ./skills рядом с кодом.
# SKILLS_DIR=

# Инструменты: пусто = все доступные. Отключить exec: TOOLS_DISABLED=exec
# TOOLS_ENABLED=
# TOOLS_DISABLED=
# Внешние пакеты с инструментами, через запятую.
# TOOL_PACKAGES=

# --- Инструмент exec ---
# Сколько секунд ждать одну команду.
EXEC_TIMEOUT=20
# Сколько символов её вывода уходит модели (остальное отрезается).
EXEC_MAX_OUTPUT=4000
# Рабочий каталог команд. Пусто — каталог, из которого запущен бот.
# EXEC_WORKDIR=
# Белый список бинарей, через запятую. Пусто = разрешено всё, что не в стоп-листе.
# Строгий режим: EXEC_ALLOWED_BINARIES=curl,cat,ls,date,head,grep,wc,python3
# EXEC_ALLOWED_BINARIES=

# --- Контекст чата ---
# Чат — одна длинная лента; /new начинает заново. Лимиты держат контекст
# в размере, который мелкая локальная модель ещё переваривает.
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=12000

# --- Настройки провайдера ollama ---
# Локальный запуск:            http://localhost:11434
# Docker Compose (сценарий B): http://ollama:11434
# Внешний хост (сценарий D):   http://<host>:11434
OLLAMA_URL=http://localhost:11434
# Рекомендованные модели: qwen3:1.7b (нужно ~4 GB RAM), tinyllama (~2 GB)
OLLAMA_MODEL=qwen3:1.7b

# --- Настройки провайдера openai_compat (vLLM, llama.cpp server, LM Studio) ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=qwen3:1.7b
# LLM_API_KEY=

# --- Настройки транспорта webhook ---
# Публичный HTTPS-адрес, TLS терминирует nginx/Caddy перед ботом
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=telegram
# Telegram пришлёт его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без него эндпоинт примет апдейт от любого, кто знает адрес.
# WEBHOOK_SECRET_TOKEN=
# WEBHOOK_WORKERS=4

# --- Опционально ---
# Whitelist: боту отвечают только эти user_id, через запятую.
# Пусто = отвечать всем, кто напишет. С инструментом exec это значит, что
# команды в системе сможет выполнять любой, кто нашёл бота — впиши свой id.
ALLOWED_USER_IDS=

# Таймаут long polling, секунды.
POLL_TIMEOUT=30

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Внешние пакеты с плагинами инференса, через запятую.
# Позволяет держать свой провайдер вне этого репозитория.
# PLUGIN_PACKAGES=
